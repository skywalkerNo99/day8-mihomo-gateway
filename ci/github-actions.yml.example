name: native-tests
on: [push, pull_request, workflow_dispatch]
permissions:
  contents: read
jobs:
  unit:
    strategy:
      matrix:
        os: [ubuntu-latest, macos-latest]
    runs-on: ${{ matrix.os }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
          cache: pip
      - run: python3 gateway bootstrap
      - run: PYTHONPATH=src .venv/bin/python -m unittest discover -s tests -v
      - run: .venv/bin/python scripts/smoke_native.py
      - run: python scripts/audit.py
