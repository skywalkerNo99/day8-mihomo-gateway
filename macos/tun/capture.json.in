{
  "mode": "rule", "log-level": "warning", "allow-lan": false,
  "profile": {"store-fake-ip": true},
  "mixed-port": 7890, "bind-address": "127.0.0.1", "ipv6": true,
  "tun": {"enable": true, "device": "utun63", "stack": "system", "auto-route": true,
          "auto-detect-interface": true, "dns-hijack": ["any:53","tcp://any:53"],
          "inet4-address": ["198.18.0.1/30"], "inet6-address": ["fdfe:dcba:9876::1/126"]},
  "dns": {"enable": true, "ipv6": true, "enhanced-mode": "fake-ip", "fake-ip-range": "198.18.0.1/16",
          "nameserver": ["https://1.1.1.1/dns-query#Gateway"]},
  "sniffer": {"enable": true, "parse-pure-ip": true, "override-destination": false, "sniff": {"TLS":{"ports":[443,8443]}, "HTTP":{"ports":[80,"8080-8880"]}}},
  "proxies": [{"name":"Gateway","type":"ss","server":"127.0.0.1","port":17892,"cipher":"aes-128-gcm","password":"__HANDOFF_KEY__","udp":false}],
  "rules": ["NETWORK,UDP,REJECT", "MATCH,Gateway", "MATCH,REJECT"]
}
